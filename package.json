{
  "name": "room-lights-card",
  "version": "1.0.27",
  "description": "A custom Home Assistant Lovelace card for controlling all lights in a room with a single tappable card.",
  "keywords": [
    "home-assistant",
    "homeassistant",
    "hacs",
    "lovelace",
    "custom-card",
    "lights",
    "room"
  ],
  "module": "dist/room-lights-card.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/YamanKoudmani/room-lights-card"
  },
  "author": "",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "rollup -c rollup.config.js --watch",
    "build": "npm run clean && npm run rollup",
    "clean": "rimraf dist",
    "rollup": "rollup -c rollup.config.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "custom-card-helpers": "^1.9.0",
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.0",
    "rimraf": "^6.0.0",
    "rollup": "^4.24.0",
    "tslib": "^2.8.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.7"
  }
}
